{
    "info": {
        "_postman_id": "jwt-spring-security-v2",
        "name": "JWT Spring Security - Full API",
        "description": "Comprehensive collection for testing all endpoints with JWT authentication and RBAC",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Authentication",
            "item": [
                {
                    "name": "Sign Up",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\",\n  \"role\": [\"user\"]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/signup",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "signup"]
                        }
                    }
                },
                {
                    "name": "Sign Up (Admin)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"adminuser\",\n  \"password\": \"admin123\",\n  \"role\": [\"admin\"]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/signup",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "signup"]
                        }
                    }
                },
                {
                    "name": "Sign In",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.environment.set('jwtToken', jsonData.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/signin",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "signin"]
                        }
                    }
                },
                {
                    "name": "Sign In (Admin)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.environment.set('jwtToken', jsonData.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"adminuser\",\n  \"password\": \"admin123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/signin",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "signin"]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Public Endpoints",
            "item": [
                {
                    "name": "Hello World",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/",
                            "host": ["{{baseUrl}}"]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. Student (MVC - JSP)",
            "item": [
                {
                    "name": "Get Student Form",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/student",
                            "host": ["{{baseUrl}}"],
                            "path": ["student"]
                        }
                    }
                },
                {
                    "name": "Submit Student Form (Admin Only)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                { "key": "firstname", "value": "John" },
                                { "key": "lastname", "value": "Doe" },
                                { "key": "email", "value": "john@example.com" },
                                { "key": "telephone", "value": "123456789" }
                            ]
                        },
                        "url": {
                            "raw": "{{baseUrl}}/addStudent.html",
                            "host": ["{{baseUrl}}"],
                            "path": ["addStudent.html"]
                        }
                    }
                }
            ]
        },
        {
            "name": "4. Student REST API",
            "item": [
                {
                    "name": "Get All Students",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/students",
                            "host": ["{{baseUrl}}"],
                            "path": ["students"]
                        }
                    }
                },
                {
                    "name": "Get Student By ID",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/students/1",
                            "host": ["{{baseUrl}}"],
                            "path": ["students", "1"]
                        }
                    }
                },
                {
                    "name": "Create Student (Admin Only)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"firstname\": \"Jane\",\n  \"lastname\": \"Smith\",\n  \"email\": \"jane@example.com\",\n  \"telephone\": \"987654321\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/students",
                            "host": ["{{baseUrl}}"],
                            "path": ["students"]
                        }
                    }
                },
                {
                    "name": "Update Student (Admin Only)",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"firstname\": \"Jane\",\n  \"lastname\": \"Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"telephone\": \"111222333\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/students/1",
                            "host": ["{{baseUrl}}"],
                            "path": ["students", "1"]
                        }
                    }
                },
                {
                    "name": "Partial Update Student (Admin Only)",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"telephone\": \"000000000\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/students/1",
                            "host": ["{{baseUrl}}"],
                            "path": ["students", "1"]
                        }
                    }
                },
                {
                    "name": "Delete Student (Admin Only)",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/students/1",
                            "host": ["{{baseUrl}}"],
                            "path": ["students", "1"]
                        }
                    }
                },
                {
                    "name": "Delete All Students (Admin Only)",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/students",
                            "host": ["{{baseUrl}}"],
                            "path": ["students"]
                        }
                    }
                }
            ]
        },
        {
            "name": "5. Example Security Endpoints",
            "item": [
                {
                    "name": "User Access",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/exampleSecurity/user",
                            "host": ["{{baseUrl}}"],
                            "path": ["exampleSecurity", "user"]
                        }
                    }
                },
                {
                    "name": "Admin Access",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/exampleSecurity/admin",
                            "host": ["{{baseUrl}}"],
                            "path": ["exampleSecurity", "admin"]
                        }
                    }
                }
            ]
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "if (!pm.environment.get('baseUrl')) {",
                    "    pm.environment.set('baseUrl', 'http://localhost:8080');",
                    "}"
                ]
            }
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080",
            "type": "string"
        },
        {
            "key": "jwtToken",
            "value": "",
            "type": "string"
        }
    ]
}